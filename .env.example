# Copy to .env and fill in. Never commit .env.

# demo = fixture connectors + scripted model, no provider calls (a DEMO badge is shown).
# live = real providers; missing credentials produce a setup error, never a fixture fallback.
OPA_MODE=demo

# scripted | anthropic
OPA_MODEL_PROVIDER=scripted
OPA_MODEL_ID=claude-opus-5
OPA_MODEL_EFFORT=high
OPA_ANTHROPIC_API_KEY=

# Database passwords used by deploy/compose.yaml (owner, app role, broker role)
OPA_DB_PASSWORD=change-me
OPA_APP_DB_PASSWORD=change-me-too
OPA_BROKER_DB_PASSWORD=change-me-three

# Shared bearer token for internal RPC between api/worker and the broker
OPA_INTERNAL_TOKEN=
# Broker key-encryption key for provider credentials: server/.venv/bin/opa generate-kek
OPA_BROKER_KEK=

# Google (live mode). Create an OAuth client of type "Web application" (see README).
OPA_GOOGLE_CLIENT_ID=
OPA_GOOGLE_CLIENT_SECRET=
OPA_GOOGLE_REDIRECT_URI=http://127.0.0.1:8080/api/oauth/google/callback
# true while the Google app is in Testing mode (refresh tokens expire after 7 days)
OPA_GOOGLE_OAUTH_TESTING=true

# Set true when serving over HTTPS
OPA_SECURE_COOKIES=false
